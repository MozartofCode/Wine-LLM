GROQ_API_KEY=
# Used solely for embeddings (text-embedding-3-small) — Groq has no embeddings API
OPENAI_API_KEY=
SUPABASE_URL=https://ulqemezcmexvfoiavjwb.supabase.co
# Service role key (NOT the anon/publishable key) — needed to bypass RLS for
# the ingestion script. Get it from Supabase dashboard > Project Settings > API.
SUPABASE_KEY=

# Optional: set to 1 when running behind a hosting proxy so rate limits see the real client IP
TRUST_PROXY=0
# Optional: shared rate-limit storage (e.g. redis://...) when running more than one worker
RATELIMIT_STORAGE_URI=memory://

# Optional: Cloudflare Turnstile secret for the community submission form (leave empty in dev)
TURNSTILE_SECRET=
# Optional: comma-separated Overpass mirrors and the User-Agent sent to OpenStreetMap services
OVERPASS_URLS=
OSM_USER_AGENT=PourDecisions/1.0 (wine education site)
# Browser origins allowed to call the API (your site's URL in production)
CORS_ORIGINS=http://localhost:3000
